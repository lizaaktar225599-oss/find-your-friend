<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Find Your Real Friend ✨💖</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            fredoka: ['Fredoka', 'sans-serif'],
            quicksand: ['Quicksand', 'sans-serif'],
          },
          colors: {
            pinkish: {
              50: '#fff1f2',
              100: '#ffe4e6',
              200: '#fecdd3',
              300: '#fda4af',
              400: '#fb7185',
              500: '#f43f5e',
              600: '#e11d48',
            }
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0px) rotate(0deg)' },
              '50%': { transform: 'translateY(-10px) rotate(4deg)' },
            },
            shake: {
              '0%, 100%': { transform: 'translateX(0)' },
              '20%, 60%': { transform: 'translateX(-6px)' },
              '40%, 80%': { transform: 'translateX(6px)' },
            },
            popIn: {
              '0%': { transform: 'scale(0.8)', opacity: '0' },
              '100%': { transform: 'scale(1)', opacity: '1' },
            },
            bounceSoft: {
              '0%, 100%': { transform: 'translateY(0)' },
              '50%': { transform: 'translateY(-6px)' }
            }
          },
          animation: {
            float: 'float 3.5s ease-in-out infinite',
            'float-delayed': 'float 3.5s ease-in-out 1.8s infinite',
            shake: 'shake 0.5s ease-in-out infinite',
            popIn: 'popIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards',
            bounceSoft: 'bounceSoft 2s ease-in-out infinite',
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Quicksand', sans-serif;
      background-color: #ffeef4;
      background-image: radial-gradient(#f472b6 1.5px, transparent 1.5px);
      background-size: 22px 22px;
      overflow-x: hidden;
    }
    
    .glass-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(14px);
      border: 3px solid #fbcfe8;
      box-shadow: 0 18px 40px rgba(244, 63, 94, 0.15);
    }

    .sticker-btn {
      transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .sticker-btn:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 10px 22px rgba(244, 63, 94, 0.2);
    }

    .sticker-btn:active {
      transform: translateY(1px) scale(0.97);
    }

    .speech-bubble-left {
      position: relative;
      background: #ffffff;
      border: 2px solid #f43f5e;
      border-radius: 18px;
    }
    .speech-bubble-left::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 20px;
      border-width: 10px 10px 0;
      border-style: solid;
      border-color: #ffffff transparent;
      display: block;
      width: 0;
    }
    .speech-bubble-left::before {
      content: '';
      position: absolute;
      bottom: -13px;
      left: 19px;
      border-width: 11px 11px 0;
      border-style: solid;
      border-color: #f43f5e transparent;
      display: block;
      width: 0;
    }

    .speech-bubble-right {
      position: relative;
      background: #fef08a;
      border: 2px solid #eab308;
      border-radius: 18px;
    }
    .speech-bubble-right::after {
      content: '';
      position: absolute;
      bottom: -10px;
      right: 20px;
      border-width: 10px 10px 0;
      border-style: solid;
      border-color: #fef08a transparent;
      display: block;
      width: 0;
    }
    .speech-bubble-right::before {
      content: '';
      position: absolute;
      bottom: -13px;
      right: 19px;
      border-width: 11px 11px 0;
      border-style: solid;
      border-color: #eab308 transparent;
      display: block;
      width: 0;
    }

    /* Tear Drop Animation */
    .tear-drop {
      position: absolute;
      width: 7px;
      height: 12px;
      background: #38bdf8;
      border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
      animation: tearFall 1.2s infinite linear;
    }

    @keyframes tearFall {
      0% { opacity: 1; transform: translateY(0) scale(0.8); }
      100% { opacity: 0; transform: translateY(30px) scale(1.2); }
    }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #ffe4e6; }
    ::-webkit-scrollbar-thumb { background: #fda4af; border-radius: 10px; }
  </style>
</head>
<body class="min-h-screen text-slate-700 flex flex-col justify-between relative selection:bg-pink-300 selection:text-pink-900">

  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute top-8 left-6 text-4xl sm:text-5xl animate-float opacity-80">🐱</div>
    <div class="absolute top-1/4 right-8 text-4xl sm:text-5xl animate-float-delayed opacity-80">⚡</div>
    <div class="absolute bottom-1/3 left-10 text-4xl sm:text-5xl animate-float opacity-80">🌸</div>
    <div class="absolute top-1/2 right-12 text-3xl sm:text-4xl animate-float-delayed opacity-80">🎀</div>
    <div class="absolute bottom-12 left-1/4 text-4xl sm:text-5xl animate-float-delayed opacity-80">📱</div>
    <div class="absolute bottom-8 right-10 text-4xl sm:text-5xl animate-float opacity-80">🔥</div>
  </div>

  <header class="w-full text-center pt-5 pb-2 z-10 px-4 relative">
    <div class="max-w-md mx-auto flex items-center justify-between mb-2">
      <!-- Language Selector Button -->
      <button onclick="toggleLanguage()" class="bg-white/90 border-2 border-pink-300 text-pink-600 font-bold px-3 py-1.5 rounded-full text-xs shadow-sm flex items-center gap-1.5 hover:bg-pink-50 transition">
        <span>🌐</span>
        <span id="lang-btn-text">Language: EN</span>
      </button>

      <!-- Settings Hub Button -->
      <button onclick="openSettingsModal()" class="bg-white/90 border-2 border-pink-300 text-pink-600 font-bold px-3 py-1.5 rounded-full text-xs shadow-sm flex items-center gap-1.5 hover:bg-pink-50 transition">
        <span>⚙️</span>
        <span id="settings-btn-text">Quiz Hub</span>
      </button>
    </div>

    <div class="inline-flex items-center gap-2 bg-white/90 px-4 py-1 rounded-full border-2 border-pink-200 shadow-sm mb-1">
      <span class="animate-bounce">⚡</span>
      <span id="header-badge" class="text-xs sm:text-sm font-bold text-pink-500 uppercase tracking-wider font-fredoka">10 Questions Bestie Test ⚡</span>
      <span class="animate-bounce">🐱</span>
    </div>

    <h1 id="header-title" class="text-3xl sm:text-4xl font-extrabold text-pink-600 font-fredoka drop-shadow-sm">
      Find Your Real Friend ⚡💖
    </h1>
    <p id="header-subtitle" class="text-pink-400 font-semibold text-xs sm:text-sm mt-1">
      Answer 10 questions, share secret code & test real friendship loyalty! 📸✨
    </p>
  </header>

  <main class="w-full max-w-md mx-auto px-4 py-2 z-10 flex-grow flex items-center justify-center">

    <!-- VIEW 0: HOME SELECTION -->
    <div id="view-home" class="w-full glass-card rounded-3xl p-6 sm:p-8 text-center transition-all duration-300">
      
      <!-- Cute Cat & Pokémon Dual SVG Illustration -->
      <div class="relative w-36 h-32 mx-auto mb-3 bg-pink-100 rounded-2xl flex items-center justify-around border-4 border-pink-300 shadow-inner p-2 overflow-hidden">
        <!-- Pokémon SVG -->
        <svg class="w-14 h-14 animate-float" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="28" fill="#facc15" />
          <circle cx="36" cy="54" r="5" fill="#ef4444" />
          <circle cx="64" cy="54" r="5" fill="#ef4444" />
          <circle cx="42" cy="46" r="3.5" fill="#1e293b" />
          <circle cx="58" cy="46" r="3.5" fill="#1e293b" />
          <polygon points="25,35 15,10 32,25" fill="#facc15" />
          <polygon points="75,35 85,10 68,25" fill="#facc15" />
        </svg>

        <!-- Cat SVG -->
        <svg class="w-14 h-14 animate-float-delayed" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="28" fill="#f43f5e" />
          <polygon points="28,30 20,12 38,22" fill="#f43f5e" />
          <polygon points="72,30 80,12 62,22" fill="#f43f5e" />
          <circle cx="40" cy="46" r="4" fill="#ffffff" />
          <circle cx="60" cy="46" r="4" fill="#ffffff" />
          <circle cx="40" cy="46" r="2" fill="#1e293b" />
          <circle cx="60" cy="46" r="2" fill="#1e293b" />
          <!-- Cat Whiskers -->
          <line x1="20" y1="52" x2="35" y2="52" stroke="#ffffff" stroke-width="2" />
          <line x1="80" y1="52" x2="65" y2="52" stroke="#ffffff" stroke-width="2" />
        </svg>
      </div>

      <h2 id="home-welcome-title" class="text-2xl font-bold text-pink-600 font-fredoka mb-1">Welcome Bestie! 💕</h2>
      <p id="home-welcome-desc" class="text-slate-600 text-xs sm:text-sm mb-5 leading-relaxed">
        Answer 10 fun questions to test if your bestie is real or fake! ✨
      </p>

      <!-- Language Switcher Box -->
      <div class="bg-pink-50 p-2.5 rounded-2xl border border-pink-200 mb-4 flex items-center justify-between">
        <span id="lang-select-label" class="text-xs font-bold text-pink-600">Language / ভাষা:</span>
        <div class="flex gap-2">
          <button id="lang-btn-en" onclick="setLanguage('en')" class="px-3 py-1 rounded-xl text-xs font-bold bg-pink-500 text-white shadow-sm">English</button>
          <button id="lang-btn-bn" onclick="setLanguage('bn')" class="px-3 py-1 rounded-xl text-xs font-bold bg-white text-pink-600 border border-pink-300">বাংলা/Banglish</button>
        </div>
      </div>

      <div class="space-y-3">
        <button onclick="switchView('view-create-init')" class="w-full sticker-btn bg-gradient-to-r from-pink-400 to-rose-400 text-white font-bold py-3.5 px-6 rounded-2xl shadow-lg border-2 border-pink-300 text-sm flex items-center justify-center gap-2">
          <span id="btn-create-quiz">✨ Create My 10-Q Quiz</span>
          <span class="text-base">👑</span>
        </button>

        <div class="relative flex py-1 items-center">
          <div class="flex-grow border-t border-pink-200"></div>
          <span id="home-or-label" class="flex-shrink mx-3 text-pink-400 font-bold text-xs">OR HAVE A SECRET CODE?</span>
          <div class="flex-grow border-t border-pink-200"></div>
        </div>

        <button onclick="switchView('view-paste-code')" class="w-full sticker-btn bg-white hover:bg-pink-50 text-pink-600 font-bold py-3 px-6 rounded-2xl shadow-sm border-2 border-pink-300 text-xs sm:text-sm flex items-center justify-center gap-2">
          <span id="btn-take-quiz">🔑 Take Bestie's Quiz</span>
        </button>
      </div>
    </div>

    <!-- VIEW 1: CREATOR SETUP -->
    <div id="view-create-init" class="w-full glass-card rounded-3xl p-6 sm:p-8 hidden transition-all duration-300">
      <div class="text-center mb-4">
        <span class="text-4xl">👑⚡</span>
        <h2 id="create-init-title" class="text-2xl font-bold text-pink-600 font-fredoka mt-1">Create Your 10-Q Quiz</h2>
        <p id="create-init-subtitle" class="text-pink-400 text-xs font-semibold">Enter your details to generate secret link!</p>
      </div>

      <form onsubmit="startCreatorQuiz(event)" class="space-y-3.5">
        <div>
          <label id="lbl-host-name" class="block text-xs font-bold text-slate-700 mb-1 ml-1">Your Cute Name ✨</label>
          <input type="text" id="host-name" required placeholder="e.g. Angel, Cutie, Sophia..." 
            class="w-full px-4 py-2.5 rounded-2xl border-2 border-pink-200 focus:border-pink-400 focus:outline-none text-slate-700 bg-white/80 font-semibold text-xs sm:text-sm" />
        </div>

        <div>
          <label id="lbl-host-ig" class="block text-xs font-bold text-slate-700 mb-1 ml-1">Your Instagram Username 📸</label>
          <div class="relative">
            <span class="absolute left-4 top-2.5 text-pink-400 font-bold text-sm">@</span>
            <input type="text" id="host-ig" required placeholder="your_insta_handle" 
              class="w-full pl-9 pr-4 py-2.5 rounded-2xl border-2 border-pink-200 focus:border-pink-400 focus:outline-none text-slate-700 bg-white/80 font-semibold text-xs sm:text-sm" />
          </div>
          <p id="lbl-host-ig-desc" class="text-[11px] text-pink-400 mt-1 ml-1">Friends will send score results straight to your IG DM!</p>
        </div>

        <button type="submit" class="w-full sticker-btn bg-pink-500 hover:bg-pink-600 text-white font-bold py-3.5 rounded-2xl shadow-md border-2 border-pink-300 text-xs sm:text-sm mt-2 flex items-center justify-center gap-2">
          <span id="btn-start-questions">Start Answering 10 Questions ➔</span>
        </button>

        <button type="button" onclick="switchView('view-home')" class="w-full text-xs text-pink-500 hover:underline font-bold text-center pt-1">
          ← <span id="btn-back-home-1">Back to Home</span>
        </button>
      </form>
    </div>

    <!-- VIEW 2: QUIZ WIZARD -->
    <div id="view-quiz-wizard" class="w-full glass-card rounded-3xl p-5 sm:p-7 hidden transition-all duration-300">
      
      <!-- 10 QUESTIONS TICK / CROSS STATUS TRACKER TOP BAR -->
      <div class="mb-4 bg-pink-50/80 p-2.5 rounded-2xl border border-pink-200">
        <div class="flex justify-between items-center text-xs font-bold text-pink-600 mb-2">
          <span id="quiz-step-label">Question 1 of 10</span>
          <span id="quiz-progress-text">10%</span>
        </div>

        <!-- 10 BADGE INDICATORS (1 to 10) -->
        <div id="tracker-badges-container" class="grid grid-cols-10 gap-1 text-center">
          <!-- Dynamically populated 1 to 10 tick/cross/pending badges -->
        </div>
      </div>

      <!-- Question Stage -->
      <div class="text-center mb-4">
        <div id="q-pokemon-stage" class="relative w-24 h-24 mx-auto mb-2 bg-pink-50 rounded-2xl border-2 border-pink-200 flex items-center justify-center shadow-inner overflow-hidden">
          <!-- Dynamic SVG graphic -->
        </div>

        <h3 id="q-title" class="text-base sm:text-lg font-bold text-pink-600 font-fredoka leading-tight min-h-[48px] flex items-center justify-center">
          Question Title
        </h3>
        <p id="q-subtitle" class="text-xs text-slate-500 mt-1 font-semibold">Select preference below:</p>
      </div>

      <!-- Options Container -->
      <div id="options-container" class="space-y-2">
        <!-- Dynamic Option Buttons -->
      </div>
    </div>

    <!-- VIEW 3: CREATOR LINK GENERATED RESULT -->
    <div id="view-created-code" class="w-full glass-card rounded-3xl p-6 sm:p-8 text-center hidden transition-all duration-300">
      <div class="text-5xl mb-2 animate-bounce">🎉⚡</div>
      <h2 id="created-title" class="text-2xl font-bold text-pink-600 font-fredoka">Quiz Created Successfully! 💕</h2>
      <p id="created-desc" class="text-slate-600 text-xs sm:text-sm mt-1 mb-4">
        Share this Secret Link with your friends to test their loyalty!
      </p>

      <div class="bg-pink-50 p-3.5 rounded-2xl border-2 border-dashed border-pink-300 mb-4">
        <p id="created-code-lbl" class="text-xs text-pink-500 font-bold uppercase tracking-wider mb-1">Your Secret Bestie Code Link</p>
        <textarea id="generated-link-box" readonly class="w-full bg-white text-pink-700 text-xs font-mono p-2.5 rounded-xl border border-pink-200 resize-none h-20 text-center font-bold focus:outline-none"></textarea>
      </div>

      <button onclick="copyGeneratedLink()" class="w-full sticker-btn bg-pink-500 hover:bg-pink-600 text-white font-bold py-3.5 px-6 rounded-2xl shadow-md border-2 border-pink-300 text-xs sm:text-sm mb-3 flex items-center justify-center gap-2">
        <span id="copy-btn-text">📋 Copy Secret Code Link</span>
      </button>

      <button onclick="switchView('view-home')" class="text-xs text-pink-500 hover:underline font-bold">
        🏠 <span id="btn-back-home-2">Back to Home</span>
      </button>
    </div>

    <!-- VIEW 4: PASTE CODE / TAKER INIT -->
    <div id="view-paste-code" class="w-full glass-card rounded-3xl p-6 sm:p-8 hidden transition-all duration-300">
      <div class="text-center mb-4">
        <span class="text-4xl">🔑⚡</span>
        <h2 id="paste-title" class="text-2xl font-bold text-pink-600 font-fredoka mt-1">Take Bestie's Quiz</h2>
        <p id="paste-subtitle" class="text-pink-400 text-xs font-semibold">Paste secret code or link to answer 10 questions!</p>
      </div>

      <form onsubmit="startTakerQuiz(event)" class="space-y-3">
        <div>
          <label id="lbl-secret-code" class="block text-xs font-bold text-slate-700 mb-1 ml-1">Paste Secret Code or Link 🔗</label>
          <textarea id="input-secret-code" required rows="2" placeholder="Paste link or code here..." 
            class="w-full p-2.5 rounded-2xl border-2 border-pink-200 focus:border-pink-400 focus:outline-none text-xs font-mono text-slate-700 bg-white/80"></textarea>
        </div>

        <div>
          <label id="lbl-taker-name" class="block text-xs font-bold text-slate-700 mb-1 ml-1">Your Cute Name ✨</label>
          <input type="text" id="taker-name" required placeholder="Your cute name..." 
            class="w-full px-4 py-2 rounded-2xl border-2 border-pink-200 focus:border-pink-400 focus:outline-none text-slate-700 bg-white/80 font-semibold text-xs sm:text-sm" />
        </div>

        <div>
          <label id="lbl-taker-ig" class="block text-xs font-bold text-slate-700 mb-1 ml-1">Your Instagram Username 📸</label>
          <div class="relative">
            <span class="absolute left-4 top-2 text-pink-400 font-bold text-sm">@</span>
            <input type="text" id="taker-ig" required placeholder="your_insta_handle" 
              class="w-full pl-9 pr-4 py-2 rounded-2xl border-2 border-pink-200 focus:border-pink-400 focus:outline-none text-slate-700 bg-white/80 font-semibold text-xs sm:text-sm" />
          </div>
        </div>

        <button type="submit" class="w-full sticker-btn bg-pink-500 hover:bg-pink-600 text-white font-bold py-3.5 rounded-2xl shadow-md border-2 border-pink-300 text-xs sm:text-sm mt-2 flex items-center justify-center gap-2">
          <span id="btn-start-guessing">Start Guessing 10 Questions ➔</span>
        </button>

        <button type="button" onclick="switchView('view-home')" class="w-full text-xs text-pink-500 hover:underline font-bold text-center pt-1">
          ← <span id="btn-back-home-3">Back to Home</span>
        </button>
      </form>
    </div>

    <!-- VIEW 5: TAKER RESULT & CAT + POKÉMON DRAMATIC DIALOGUE SCENE -->
    <div id="view-final-results" class="w-full glass-card rounded-3xl p-5 sm:p-7 text-center hidden transition-all duration-300">
      
      <!-- TOP 10 QUESTIONS TICK/CROSS BADGES SUMMARY -->
      <div class="bg-pink-50 p-2.5 rounded-2xl border border-pink-200 mb-3">
        <p id="result-badges-title" class="text-[11px] font-bold text-pink-600 uppercase tracking-wider mb-1.5">10 Questions Scorecard (✓ Match / ✗ Mismatch)</p>
        <div id="final-badges-container" class="grid grid-cols-10 gap-1 text-center">
          <!-- 1 to 10 result badges -->
        </div>
      </div>

      <h2 id="result-title" class="text-xl sm:text-2xl font-bold text-pink-600 font-fredoka">Match Score: 8/10!</h2>
      <p id="result-desc" class="text-slate-600 text-xs sm:text-sm mt-0.5 mb-3">You guys are soulmates! 👯‍♀️</p>

      <!-- DRAMATIC CAT & POKÉMON CONVERSATION STAGE (Appears on low score / mistakes) -->
      <div id="cat-pokemon-dialogue-stage" class="hidden bg-gradient-to-b from-rose-50 to-pink-100 border-2 border-rose-300 p-3.5 rounded-2xl mb-4 text-left shadow-sm animate-popIn">
        
        <p class="text-[11px] font-bold text-rose-600 uppercase tracking-wider mb-2 flex items-center gap-1">
          <span>🐱⚡ DRAMATIC FRIENDSHIP DIALOGUE</span>
        </p>

        <!-- Conversation Bubble 1: Angry/Dramatic Cat -->
        <div class="flex items-start gap-2 mb-3">
          <!-- Cat SVG -->
          <div class="relative w-12 h-12 flex-shrink-0 bg-white rounded-full border-2 border-rose-400 flex items-center justify-center shadow-sm overflow-hidden">
            <svg class="w-10 h-10 animate-shake" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="30" fill="#f43f5e" />
              <polygon points="28,30 20,12 38,22" fill="#f43f5e" />
              <polygon points="72,30 80,12 62,22" fill="#f43f5e" />
              <!-- Angry eyes -->
              <line x1="32" y1="40" x2="44" y2="46" stroke="#ffffff" stroke-width="3" />
              <line x1="68" y1="40" x2="56" y2="46" stroke="#ffffff" stroke-width="3" />
              <path d="M 40 58 Q 50 50 60 58" stroke="#ffffff" stroke-width="3" fill="none" />
            </svg>
          </div>
          <!-- Cat Speech Bubble -->
          <div class="speech-bubble-left p-2.5 text-xs font-extrabold text-rose-700 leading-snug flex-grow">
            "Tumi fail korso!! Jaw tumi!! 😾💔"
          </div>
        </div>

        <!-- Conversation Bubble 2: Real Friend Pokémon -->
        <div class="flex items-start gap-2 flex-row-reverse">
          <!-- Pokémon SVG -->
          <div class="relative w-12 h-12 flex-shrink-0 bg-yellow-100 rounded-full border-2 border-yellow-400 flex items-center justify-center shadow-sm overflow-hidden">
            <svg class="w-10 h-10 animate-bounceSoft" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="28" fill="#facc15" />
              <circle cx="36" cy="54" r="5" fill="#ef4444" />
              <circle cx="64" cy="54" r="5" fill="#ef4444" />
              <circle cx="42" cy="46" r="3.5" fill="#1e293b" />
              <circle cx="58" cy="46" r="3.5" fill="#1e293b" />
              <path d="M 44 58 Q 50 64 56 58" stroke="#1e293b" stroke-width="2.5" fill="none" />
            </svg>
          </div>
          <!-- Pokémon Speech Bubble -->
          <div class="speech-bubble-right p-2.5 text-xs font-extrabold text-amber-900 leading-snug flex-grow">
            "Sorry... kintu AMI-i tomar real friend!! Don't cry bestie! 🥺💖⚡"
          </div>
