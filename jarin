    function startCreatorQuiz(e) {
      e.preventDefault();
      const name = document.getElementById('host-name').value.trim();
      const ig = document.getElementById('host-ig').value.trim().replace('@', '');
      if (!name || !ig) return;

      hostData.name = name;
      hostData.ig = ig;
      hostData.answers = {};

      currentMode = 'creator';
      currentStep = 0;

      switchView('view-quiz-wizard');
      renderQuestion();
    }

    function startTakerQuiz(e) {
      e.preventDefault();
      const rawCode = document.getElementById('input-secret-code').value.trim();
      const name = document.getElementById('taker-name').value.trim();
      const ig = document.getElementById('taker-ig').value.trim().replace('@', '');

      if (!rawCode || !name || !ig) return;

      try {
        let codeStr = rawCode;
        if(rawCode.includes('#quiz=')) {
          codeStr = rawCode.split('#quiz=')[1];
        }

        const decoded = JSON.parse(base64ToUtf8(decodeURIComponent(codeStr)));
        if (!decoded.name || !decoded.answers || !decoded.ig) {
          throw new Error("Invalid Code");
        }

        hostData = decoded;
        takerData.name = name;
        takerData.ig = ig;
        takerData.answers = {};

        currentMode = 'taker';
        currentStep = 0;

        switchView('view-quiz-wizard');
        renderQuestion();
      } catch (err) {
        alert(currentLang === 'en' 
          ? "Oops! That Secret Code seems invalid or broken. Please double check and try again! 🥺"
          : "ওফস! সিক্রেট কোডটি কাজ করছে না। দয়া করে সঠিক কোডটি পেস্ট করো! 🥺");
      }
    }

    /* RENDER TOP 10 BADGES STATUS INDICATOR */
    function renderTopBadges() {
      const container = document.getElementById('tracker-badges-container');
      container.innerHTML = '';

      QUESTIONS.forEach((q, idx) => {
        const badge = document.createElement('div');
        badge.className = "h-7 rounded-lg text-xs font-extrabold flex items-center justify-center transition-all ";

        if (currentMode === 'creator') {
          if (hostData.answers[q.id]) {
            badge.className += "bg-pink-500 text-white shadow-sm";
            badge.innerText = "✓";
          } else if (idx === currentStep) {
            badge.className += "bg-pink-200 text-pink-700 border-2 border-pink-400 animate-pulse";
            badge.innerText = idx + 1;
          } else {
            badge.className += "bg-white text-pink-300 border border-pink-200";
            badge.innerText = idx + 1;
          }
        } else {
          // Taker mode with Green Ticks (✓) and Red Crosses (✗)
          if (takerData.answers[q.id]) {
            const isMatch = takerData.answers[q.id] === hostData.answers[q.id];
            if (isMatch) {
              badge.className += "bg-emerald-500 text-white shadow-sm";
              badge.innerText = "✓";
            } else {
              badge.className += "bg-rose-500 text-white shadow-sm";
              badge.innerText = "✗";
            }
          } else if (idx === currentStep) {
            badge.className += "bg-pink-200 text-pink-700 border-2 border-pink-400 animate-pulse";
            badge.innerText = idx + 1;
          } else {
            badge.className += "bg-white text-pink-300 border border-pink-200";
            badge.innerText = idx + 1;
          }
        }

        container.appendChild(badge);
      });
    }

    function renderQuestion() {
      const q = QUESTIONS[currentStep];
      const total = QUESTIONS.length;

      const progressPercent = Math.round(((currentStep + 1) / total) * 100);
      document.getElementById('quiz-step-label').innerText = `Question ${currentStep + 1} of 10`;
      document.getElementById('quiz-progress-text').innerText = `${progressPercent}%`;

      renderTopBadges();
      renderPokemonGraphic(q.graphic);
      
      const qTitle = currentLang === 'en' ? q.title_en : q.title_bn;
      
      if (currentMode === 'creator') {
        document.getElementById('q-title').innerText = qTitle;
        document.getElementById('q-subtitle').innerText = currentLang === 'en' ? "Pick your preference ✨" : "তোমার পছন্দ সিলেক্ট করো ✨";
      } else {
        document.getElementById('q-title').innerText = `${hostData.name}'s Choice: "${qTitle}"`;
        document.getElementById('q-subtitle').innerText = currentLang === 'en' ? `Guess ${hostData.name}'s answer! 🙈` : `${hostData.name}-এর উত্তর গেস করো! 🙈`;
      }

      const container = document.getElementById('options-container');
      container.innerHTML = '';

      const opts = currentLang === 'en' ? q.options_en : q.options_bn;

      opts.forEach((opt) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'w-full text-left p-3 rounded-2xl border-2 border-pink-200 hover:border-pink-400 bg-white hover:bg-pink-50 text-slate-700 font-semibold text-xs transition-all flex items-center justify-between sticker-btn shadow-sm';
        btn.innerHTML = `
          <span>${opt.text}</span>
          <span class="text-pink-400 text-xs">💖</span>
        `;
        btn.onclick = () => selectOption(q.id, opt.val);
        container.appendChild(btn);
      });
    }

    function selectOption(qId, val) {
      if (currentMode === 'creator') {
        hostData.answers[qId] = val;
      } else {
        takerData.answers[qId] = val;
      }

      if (currentStep < QUESTIONS.length - 1) {
        currentStep++;
        renderQuestion();
      } else {
        if (currentMode === 'creator') {
          finishCreatorQuiz();
        } else {
          finishTakerQuiz();
        }
      }
    }

    function finishCreatorQuiz() {
      const jsonStr = JSON.stringify(hostData);
      const encodedStr = encodeURIComponent(utf8ToBase64(jsonStr));
      const fullLink = `${window.location.origin}${window.location.pathname}#quiz=${encodedStr}`;
      
      document.getElementById('generated-link-box').value = fullLink;
      saveQuizToLocal(hostData.name, fullLink);

      confetti({ particleCount: 80, spread: 70, origin: { y: 0.6 } });
      switchView('view-created-code');
    }

    function copyGeneratedLink() {
      const copyText = document.getElementById("generated-link-box");
      copyText.select();
      copyText.setSelectionRange(0, 99999);
      document.execCommand("copy");

      const copyBtnText = document.getElementById("copy-btn-text");
      copyBtnText.innerText = currentLang === 'en' ? "✅ Secret Link Copied!" : "✅ লিংক কপি হয়েছে!";
      showToast("Secret Link copied! 📋");

      setTimeout(() => {
        copyBtnText.innerText = TRANSLATIONS[currentLang].copyBtn;
      }, 3000);
    }

    function finishTakerQuiz() {
